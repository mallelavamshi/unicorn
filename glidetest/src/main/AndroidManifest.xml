<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:label="Glide test" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".GlideTestActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The demo video's unbranded chat screen (docs/plan/demo-video.md) -->
        <activity
            android:name=".StageActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize" />
    </application>

    <instrumentation
        android:name=".GlideInstrumentation"
        android:targetPackage="ai.unicorn.glidetest"
        android:label="Glide typing end-to-end" />
</manifest>
