{
  // The website: static files only, served by Cloudflare at https://unicorn.cognovaai.com (and still at
  // unicorn-site.<account>.workers.dev).
  // Deploy from this folder with `npx wrangler deploy` (the backend has its own config in ../backend).
  "$schema": "../backend/node_modules/wrangler/config-schema.json",
  "name": "unicorn-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  // No scheduled jobs; an empty list removes any left from an earlier deploy
  "triggers": { "crons": [] },
  "routes": [{ "pattern": "unicorn.cognovaai.com", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": false
}
