<merge
    xmlns:latin="http://schemas.android.com/apk/res-auto"
>
    <!-- Unicorn: Samsung's bottom row (symbols, comma, wide space, period, return). Emoji is in the
         suggestion row. URL and email fields get "/" or "@" in place of the comma. -->
    <switch>
        <case
            latin:mode="url|email"
        >
            <Row
                latin:keyWidth="10%p"
            >
                <Key
                    latin:keyStyle="toSymbolKeyStyle"
                    latin:keyWidth="15%p" />
                <include
                    latin:keyboardLayout="@xml/key_comma" />
                <include
                    latin:keyXPos="25%p"
                    latin:keyboardLayout="@xml/key_space_5kw" />
                <include
                    latin:keyboardLayout="@xml/key_period" />
                <Key
                    latin:keyStyle="enterKeyStyle"
                    latin:keyWidth="fillRight" />
            </Row>
        </case>
        <default>
            <Row
                latin:keyWidth="10%p"
            >
                <Key
                    latin:keyStyle="toSymbolKeyStyle"
                    latin:keyWidth="15%p" />
                <!-- Comma and period look like letter keys, as on Samsung's -->
                <Key
                    latin:keySpec="!text/keyspec_comma"
                    latin:keyLabelFlags="hasPopupHint"
                    latin:keyStyle="settingsMoreKeysStyle"
                    latin:backgroundType="normal" />
                <Key
                    latin:keyStyle="spaceKeyStyle"
                    latin:keyWidth="50%p" />
                <Key
                    latin:keySpec="!text/keyspec_period"
                    latin:keyHintLabel="!text/keyhintlabel_period"
                    latin:keyLabelFlags="hasPopupHint|hasShiftedLetterHint"
                    latin:moreKeys="!text/morekeys_period"
                    latin:backgroundType="normal" />
                <Key
                    latin:keyStyle="enterKeyStyle"
                    latin:keyWidth="fillRight" />
            </Row>
        </default>
    </switch>
</merge>
