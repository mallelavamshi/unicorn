<!-- Unicorn: five rows with the number row (see rows_qwerty), so the letter rows are a little shorter with tighter
     gaps, as on Samsung's -->
<Keyboard
    xmlns:latin="http://schemas.android.com/apk/res-auto"
    latin:rowHeight="20.5%p"
    latin:verticalGap="@fraction/config_key_vertical_gap_number_row"
>
    <include
        latin:keyboardLayout="@xml/rows_qwerty" />
</Keyboard>
