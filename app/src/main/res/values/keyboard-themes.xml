<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- For keyboard color scheme option dialog. -->
    <!-- Unicorn: order and names match tools/keyboard_themes.json. -->
    <string-array name="keyboard_theme_names" translatable="false">
        <item>Classic</item>
        <item>Classic Dark</item>
        <item>Unicorn</item>
        <item>Unicorn Night</item>
        <item>Midnight</item>
        <item>Mint</item>
        <item>Rose</item>
        <item>Graphite</item>
        <item>Aurora</item>
    </string-array>
    <!-- An element must be a keyboard theme id of
         {@link com.android.inputmethod.keyboard.KeyboardTheme#THEME_ID_ICS} etc. -->
    <integer-array name="keyboard_theme_ids" translatable="false">
        <item>10</item>
        <item>11</item>
        <item>3</item>
        <item>4</item>
        <item>12</item>
        <item>13</item>
        <item>14</item>
        <item>15</item>
        <item>16</item>
    </integer-array>
</resources>
