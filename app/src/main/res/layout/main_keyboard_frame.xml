<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:orientation="vertical" >

    <!-- To ensure that key preview popup is correctly placed when the current system locale is
         one of RTL locales, layoutDirection="ltr" is needed in the SDK version 17+. -->
    <!-- Unicorn: AI tools, recall chip and saving indicator -->
    <ai.unicorn.keyboard.UnicornBar
        android:id="@+id/unicorn_bar"
        android:layout_width="match_parent"
        android:layout_height="44dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.android.inputmethod.latin.suggestions.SuggestionStripView
            android:id="@+id/suggestion_strip_view"
            android:layoutDirection="ltr"
            android:layout_width="match_parent"
            android:layout_height="@dimen/config_suggestions_strip_height"
            android:gravity="center_vertical"
            style="?attr/suggestionStripViewStyle" />

        <!-- Unicorn: starters and slash commands over the suggestions while the prompt bar is open -->
        <ai.unicorn.keyboard.PromptChips
            android:id="@+id/unicorn_prompt_chips"
            android:layout_width="match_parent"
            android:layout_height="@dimen/config_suggestions_strip_height"
            android:visibility="gone" />
    </FrameLayout>

    <!-- To ensure that key preview popup is correctly placed when the current system locale is
         one of RTL locales, layoutDirection="ltr" is needed in the SDK version 17+. -->
    <FrameLayout
        android:id="@+id/unicorn_keyboard_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.android.inputmethod.keyboard.MainKeyboardView
            android:id="@+id/keyboard_view"
            android:layoutDirection="ltr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Unicorn: AI tool results shown over the keys -->
        <ai.unicorn.keyboard.AiPanelView
            android:id="@+id/unicorn_ai_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
